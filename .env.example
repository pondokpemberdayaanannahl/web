# Replace with your team's Supabase project URL and public key.
VITE_SUPABASE_URL=https://PROYEK.supabase.co
VITE_SUPABASE_ANON_KEY=PUBLIC_KEY_PROYEK

# Development only; production builds ignore this account.
# Pendaftaran/donasi use /api/forms.php and private Google configuration outside the web root.
# Run npm run forms:dev alongside Vite locally. Never add the Google shared secret to VITE_*.
VITE_DUMMY_LOGIN_ENABLED=true
VITE_DUMMY_USERNAME=admin
VITE_DUMMY_PASSWORD=123
